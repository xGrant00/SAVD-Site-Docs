<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex">
<title>SAVD Site Guide</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap">
<style>
/* Layout: white page, one centered reading column, sticky chip nav; big tap targets; SAVD type (Archivo Expanded / Geist / Geist Mono) and colors from savd.css. Light only, on purpose. */
:root {
  --paper: #ffffff; --ink: #0a0a0a; --ink-2: #474747; --ink-3: #737373;
  --line: #e7e7e7; --line-2: #d4d4d4; --soft: #f4f5f4; --green: #224940; --green-2: #2f6355;
  --green-soft: #e9f1ee; --mint: #9cc9b8; --warn: #fbf3e2; --warn-ink: #714500;
  --display: "Archivo", "Geist", system-ui, sans-serif;
  --body: "Geist", system-ui, -apple-system, "Segoe UI", sans-serif;
  --mono: "Geist Mono", ui-monospace, "SF Mono", Menlo, monospace;
  --r-sm: 10px; --r-md: 14px; --r-lg: 20px;
  color-scheme: light;
}
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 76px; -webkit-text-size-adjust: 100%; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before { transition: none !important; } }
body { background: var(--paper); color: var(--ink); font: 400 16px/1.6 var(--body); -webkit-font-smoothing: antialiased; }
p, h1, h2, h3, ol, ul { margin: 0; }
a { color: var(--green); text-underline-offset: 3px; }
b { font-weight: 600; }
:focus-visible { outline: 2.5px solid var(--green); outline-offset: 3px; border-radius: 6px; }
.x { width: .62em; height: .86em; display: inline-block; vertical-align: -.06em; }

.wrap { width: 100%; max-width: 1080px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
@media (min-width: 720px) { .wrap { padding-left: max(32px, env(safe-area-inset-left, 0px)); padding-right: max(32px, env(safe-area-inset-right, 0px)); } }

.d { font-family: var(--display); font-weight: 800; font-stretch: 125%; text-transform: uppercase; letter-spacing: -.025em; line-height: .95; text-wrap: balance; }
.eyebrow { font: 500 12px/1 var(--mono); letter-spacing: .07em; text-transform: uppercase; color: var(--green); display: inline-flex; align-items: center; gap: 10px; }
.eyebrow::before { content: ""; width: 6px; height: 6px; background: currentColor; transform: rotate(45deg); flex: none; }

/* top */
.top .wrap { padding-block: 22px 0; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
.wm { height: 17px; width: auto; color: var(--ink); display: block; }
.top__tag { font: 500 11px/1 var(--mono); letter-spacing: .07em; text-transform: uppercase; color: var(--ink-3); display: inline-flex; gap: 6px; align-items: center; }

.hero .wrap { padding-block: clamp(40px, 8vw, 88px) clamp(32px, 6vw, 64px); display: grid; gap: clamp(28px, 4vw, 44px); }
body { background: radial-gradient(900px 640px at 100% 0%, #eaf2ee 0%, rgba(234,242,238,0) 70%) no-repeat, var(--paper); }
.hero__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(32px, 5vw, 56px); align-items: center; }
@media (min-width: 940px) { .hero__grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); } }
.hero__head { display: grid; gap: 18px; justify-items: start; }
.hero h1 { font-size: clamp(36px, 10.5vw, 84px); }
@media (min-width: 940px) { .hero h1 { font-size: clamp(48px, 6.2vw, 80px); } }
.hero__cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
.btn { position: relative; overflow: hidden; isolation: isolate; display: inline-flex; align-items: center; gap: 10px; height: 52px; padding: 0 24px; border-radius: var(--r-md); background: var(--ink); color: #fff; text-decoration: none; font: 700 12.5px/1 var(--display); font-stretch: 112%; letter-spacing: .06em; text-transform: uppercase; }
.btn::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--green); transform: translateY(101%); transition: transform .45s cubic-bezier(.16,1,.3,1); }
.btn:hover::before { transform: none; }
.btn svg { width: 16px; height: 16px; transition: transform .3s; }
.btn:hover svg { transform: translateX(3px); }
.btn--line { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--ink); }
.btn--line::before { background: var(--ink); }
.btn--line:hover { color: #fff; }

/* editor illustration */
.ed { margin: 0; width: 100%; border-radius: 18px; background: #fff; border: 1px solid var(--line-2); box-shadow: 0 2px 4px rgba(0,0,0,.04), 0 30px 60px -24px rgba(16,40,33,.28); overflow: visible; position: relative; }
.ed__top { height: 44px; display: flex; align-items: center; gap: 12px; padding: 0 12px; border-bottom: 1px solid var(--line); position: relative; }
.ed__dots { display: flex; gap: 5px; }
.ed__dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--line-2); }
.ed__pg { margin: 0 auto; display: inline-flex; align-items: center; gap: 6px; height: 28px; padding: 0 10px; border-radius: 8px; background: var(--soft); font: 500 12px/1 var(--body); }
.ed__pg svg { width: 10px; height: 10px; }
.ed__save { position: relative; height: 30px; padding: 0 14px; border-radius: 8px; background: var(--green); color: #fff; display: inline-flex; align-items: center; font: 600 12.5px/1 var(--body); }
.ed__body { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.25fr); min-height: 250px; }
.ed__side { border-right: 1px solid var(--line); padding: 12px 10px; display: grid; gap: 5px; align-content: start; }
.ed__lab { font: 500 9.5px/1 var(--mono); letter-spacing: .07em; text-transform: uppercase; color: var(--ink-3); padding: 4px 6px 6px; }
.ed__row { position: relative; font: 500 11.5px/1.2 var(--body); padding: 8px; border-radius: 7px; color: var(--ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ed__row--on { background: var(--green-soft); color: var(--green); font-weight: 600; box-shadow: inset 0 0 0 1.5px var(--green); overflow: visible; }
.ed__row--add { color: var(--green); }
.ed__view { padding: 12px; background: #fafafa; border-radius: 0 0 18px 0; display: grid; gap: 8px; align-content: start; }
.ed__hdr { height: 24px; border-radius: 999px; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.08); display: flex; align-items: center; justify-content: space-between; padding: 0 10px; }
.ed__hdr .wm { height: 7px; }
.ed__hdr i { width: 22px; height: 6px; border-radius: 3px; background: var(--line-2); }
.ed__ban { height: 116px; border-radius: 10px; background: linear-gradient(135deg, #224940, #2f6355 60%, #9cc9b8 160%); color: #fff; padding: 12px; display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start; box-shadow: inset 0 0 0 2px var(--green), 0 0 0 3px #fff, 0 0 0 4.5px var(--green); }
.ed__ban span { font: 800 17px/.95 var(--display); font-stretch: 125%; text-transform: uppercase; }
.ed__ban b { font: 600 9.5px/1 var(--mono); text-transform: uppercase; letter-spacing: .05em; background: #fff; color: var(--ink); padding: 6px 8px; border-radius: 6px; }
.ed__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
.ed__cards i { height: 54px; border-radius: 8px; background: #ececec; }
.mk { position: absolute; width: 24px; height: 24px; border-radius: 8px; background: var(--ink); color: #fff; display: grid; place-items: center; font: 800 11px/1 var(--display); font-stretch: 125%; box-shadow: 0 0 0 3px #fff; z-index: 2; }
.mk--1 { left: -10px; top: -10px; }
.mk--2 { right: -8px; top: -9px; }
.mk--3 { right: -10px; top: -12px; background: var(--green); animation: ping 2.4s ease-out infinite; }
@keyframes ping { 0% { box-shadow: 0 0 0 3px #fff, 0 0 0 3px rgba(34,73,64,.45); } 70%, 100% { box-shadow: 0 0 0 3px #fff, 0 0 0 14px rgba(34,73,64,0); } }
@media (prefers-reduced-motion: reduce) { .mk--3 { animation: none; } }
@media (max-width: 520px) {
  .ed__body { grid-template-columns: minmax(0, 1fr); }
  .ed__side { border-right: 0; border-bottom: 1px solid var(--line); grid-template-columns: minmax(0, 1fr); }
  .ed__row:not(.ed__row--on) { display: none; }
  .ed__lab { display: none; }
  .ed__view { border-radius: 0 0 18px 18px; }
}
.hero h1 em { font-style: normal; color: var(--green); }
.hero__lede { font-size: clamp(17px, 2vw, 20px); color: var(--ink-2); max-width: 44ch; }
.steps3 { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 12px; }
.steps3 li { background: var(--soft); border-radius: var(--r-lg); padding: 20px; display: grid; gap: 8px; align-content: start; }
.steps3 .n { width: 36px; height: 36px; border-radius: 11px; background: var(--ink); color: #fff; display: grid; place-items: center; font: 800 15px/1 var(--display); font-stretch: 125%; }
.steps3 li:last-child .n { background: var(--green); }
.steps3 b { font: 800 17px/1.1 var(--display); font-stretch: 112%; text-transform: uppercase; }
.steps3 p { color: var(--ink-2); font-size: 15px; }

/* nav */
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: rgba(255,255,255,.96); }
.nav { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 9; background: rgba(255,255,255,.94); backdrop-filter: saturate(1.4) blur(10px); -webkit-backdrop-filter: saturate(1.4) blur(10px); border-block: 1px solid var(--line); }
.nav ol { list-style: none; padding: 10px 0; display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; }
.nav ol::-webkit-scrollbar { display: none; }
.nav a { flex: none; display: inline-flex; align-items: center; height: 40px; padding: 0 16px; border-radius: 999px; background: var(--soft); color: var(--ink); text-decoration: none; font: 500 14px/1 var(--body); white-space: nowrap; transition: background .2s, color .2s; }
.nav a:hover { background: #e9ebe9; }
.nav a.on { background: var(--ink); color: #fff; }

/* chapters */
.ch { padding-block: clamp(48px, 8vw, 88px) 0; display: grid; gap: 20px; }
.ch__head { display: grid; gap: 12px; }
.ch h2 { font-size: clamp(30px, 5.4vw, 56px); }
.ch__lede { font-size: clamp(16px, 1.8vw, 18px); color: var(--ink-2); max-width: 58ch; }
.sub { font: 800 16px/1.1 var(--display); font-stretch: 112%; text-transform: uppercase; margin-top: 14px; }

/* click path */
.path { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
.path span { display: inline-flex; align-items: center; min-height: 34px; padding: 4px 12px; border-radius: 9px; background: var(--soft); font: 500 14px/1.2 var(--body); }
.path i { font-style: normal; color: var(--ink-3); font-size: 14px; }
.path span:last-child { background: var(--ink); color: #fff; }
.path--sm span { min-height: 28px; padding: 3px 9px; font-size: 13px; border-radius: 7px; }
.path--sm span:last-child { background: var(--green-soft); color: var(--green); font-weight: 600; }

/* page diagram + words */
.learn { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; align-items: start; }
@media (min-width: 820px) { .learn { grid-template-columns: minmax(0, 320px) minmax(0, 1fr); gap: 28px; } }
.mock { border: 1.5px solid var(--line-2); border-radius: 22px; padding: 12px; display: grid; gap: 8px; background: #fff; max-width: 360px; width: 100%; }
.mock__bar { height: 26px; border-radius: 8px; background: var(--ink); display: flex; align-items: center; padding: 0 10px; }
.mock__bar .wm { height: 8px; color: #fff; }
.strip { border-radius: 10px; padding: 10px; display: grid; gap: 6px; position: relative; }
.strip--a { background: #dfe9e5; height: 92px; }
.strip--b { background: var(--soft); }
.strip--c { background: var(--green); color: #fff; }
.strip__lab { font: 500 10px/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; }
.blocks { display: flex; gap: 6px; flex-wrap: wrap; }
.blk { height: 30px; flex: 1 1 60px; border-radius: 7px; border: 1.5px dashed var(--green); background: #fff; display: grid; place-items: center; font: 500 10px/1 var(--mono); color: var(--green); text-transform: uppercase; letter-spacing: .04em; }
.callout { position: absolute; right: 8px; top: 8px; font: 500 10px/1 var(--mono); text-transform: uppercase; letter-spacing: .05em; background: var(--ink); color: #fff; padding: 5px 7px; border-radius: 6px; }
.words { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 10px; }
.word { border: 1px solid var(--line); border-radius: var(--r-md); padding: 16px; display: grid; gap: 4px; align-content: start; }
.word b { font: 800 15px/1.1 var(--display); font-stretch: 112%; text-transform: uppercase; }
.word p { color: var(--ink-2); font-size: 15px; }

.rules { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); gap: 10px; }
.rules li { background: var(--green-soft); border-radius: var(--r-md); padding: 16px 18px; display: grid; gap: 4px; }
.rules b { font-size: 16px; }
.rules p { color: var(--ink-2); font-size: 15px; }

/* search + filters */
.find { position: relative; }
.find input { width: 100%; height: 58px; border-radius: 16px; border: 2px solid var(--line-2); background: #fff; color: var(--ink); padding: 0 18px 0 50px; font: 400 17px var(--body); -webkit-appearance: none; appearance: none; }
.find input::placeholder { color: var(--ink-3); }
.find input:focus { outline: none; border-color: var(--green); }
.find svg { position: absolute; left: 18px; top: 50%; width: 20px; height: 20px; transform: translateY(-50%); color: var(--ink-3); pointer-events: none; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.filters { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding-bottom: 2px; }
.filters::-webkit-scrollbar { display: none; }
.fbtn { flex: none; height: 40px; padding: 0 14px; border-radius: 999px; border: 1.5px solid var(--line-2); background: #fff; color: var(--ink); font: 500 14px/1 var(--body); cursor: pointer; }
.fbtn[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: #fff; }
.count { font: 500 12px/1 var(--mono); letter-spacing: .05em; text-transform: uppercase; color: var(--ink-3); }
.none { padding: 28px 18px; border: 1.5px dashed var(--line-2); border-radius: var(--r-lg); color: var(--ink-3); text-align: center; }

/* tasks */
.tgroup { display: grid; gap: 8px; }
.tgroup + .tgroup { margin-top: 18px; }
.tgroup > h3 { font: 500 12px/1 var(--mono); letter-spacing: .07em; text-transform: uppercase; color: var(--ink-3); padding-left: 2px; }
.task { border: 1.5px solid var(--line); border-radius: var(--r-lg); background: #fff; transition: border-color .2s, box-shadow .2s; }
.task[open] { border-color: var(--ink); box-shadow: 0 10px 30px -18px rgba(0,0,0,.35); }
.task > summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 12px; align-items: center; min-height: 64px; padding: 12px 16px 12px 20px; }
.task > summary::-webkit-details-marker { display: none; }
.task__t { font: 600 17px/1.3 var(--body); }
.time { font: 500 11px/1 var(--mono); letter-spacing: .04em; text-transform: uppercase; color: var(--green); background: var(--green-soft); padding: 6px 8px; border-radius: 7px; white-space: nowrap; }
.time--dev { color: var(--warn-ink); background: var(--warn); }
.chev { width: 32px; height: 32px; border-radius: 10px; background: var(--soft); display: grid; place-items: center; transition: transform .25s, background .2s; }
.chev svg { width: 14px; height: 14px; }
.task[open] .chev { transform: rotate(180deg); background: var(--ink); color: #fff; }
.task__body { padding: 0 20px 22px; display: grid; gap: 16px; }
.how { list-style: none; padding: 0; counter-reset: s; display: grid; gap: 12px; }
.how li { counter-increment: s; display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 12px; align-items: start; font-size: 16px; color: var(--ink-2); }
.how li::before { content: counter(s); width: 30px; height: 30px; border-radius: 9px; background: var(--ink); color: #fff; display: grid; place-items: center; font: 800 13px/1 var(--display); font-stretch: 125%; }
.how li b { color: var(--ink); }
.how li:last-child::before { background: var(--green); }
.good { background: var(--soft); border-radius: var(--r-md); padding: 12px 14px; font-size: 15px; color: var(--ink-2); }
.good b { color: var(--ink); }
.word-tag { display: inline-block; font: 500 .88em/1.2 var(--mono); background: var(--green-soft); color: var(--green); padding: 2px 7px; border-radius: 6px; white-space: nowrap; }
@media (max-width: 480px) {
  .task > summary { grid-template-columns: minmax(0, 1fr) auto; padding-left: 16px; }
  .task > summary .time { grid-column: 1; grid-row: 2; justify-self: start; }
  .task > summary .chev { grid-column: 2; grid-row: 1 / span 2; }
  .task__body { padding: 0 16px 20px; }
}

/* settings */
.sets { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 10px; }
.set { border: 1px solid var(--line); border-radius: var(--r-md); padding: 16px 18px; display: grid; gap: 8px; align-content: start; }
.set__top { display: flex; justify-content: space-between; gap: 10px; align-items: baseline; flex-wrap: wrap; }
.set__top b { font-size: 16px; }
.now { font: 500 12px/1.2 var(--mono); color: var(--ink); background: var(--soft); border-radius: 6px; padding: 5px 8px; display: inline-flex; gap: 6px; align-items: center; }
.set p { font-size: 15px; color: var(--ink-2); }
.dot { width: 12px; height: 12px; border-radius: 4px; box-shadow: inset 0 0 0 1px rgba(0,0,0,.15); display: inline-block; flex: none; }
.swrow { display: flex; flex-wrap: wrap; gap: 6px; }
.sw { display: inline-flex; gap: 6px; align-items: center; height: 30px; padding: 0 10px; border-radius: 8px; background: var(--soft); font-size: 13.5px; }

/* page parts */
.parts { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 10px; align-items: start; }
.pc { border: 1px solid var(--line); border-radius: var(--r-lg); padding: 18px; display: grid; gap: 10px; min-width: 0; }
.pc h3 { font: 800 15px/1.15 var(--display); font-stretch: 112%; text-transform: uppercase; }
.pc__what { color: var(--ink-2); font-size: 15.5px; }
.pc__where { display: grid; gap: 6px; }
.pc__where > b, .pc__row b { font: 500 11px/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-3); font-weight: 500; }
.pc__row { font-size: 14px; color: var(--ink-2); display: grid; gap: 6px; }
.tags { display: flex; flex-wrap: wrap; gap: 5px; }
.tag { display: inline-flex; align-items: center; height: 26px; padding: 0 9px; border-radius: 7px; background: var(--soft); font-size: 13px; color: var(--ink); }
.tag--more, .tag--off { background: transparent; box-shadow: inset 0 0 0 1px var(--line-2); color: var(--ink-3); }
.pc__tip { font-size: 14.5px; background: var(--green-soft); color: var(--ink); border-radius: var(--r-sm); padding: 10px 12px; }
.pc__tip::before { content: "Tip  "; font: 500 11px/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--green); white-space: pre; }

/* magic words */
.magic { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 10px; }
.pc__ed { font: 500 11px/1.3 var(--mono); color: var(--ink-3); letter-spacing: .02em; margin-top: -4px; }
.pc { transition: border-color .2s, box-shadow .2s; }
.pc:hover, .set:hover { border-color: var(--line-2); box-shadow: 0 10px 24px -18px rgba(0,0,0,.3); }
.set { transition: border-color .2s, box-shadow .2s; }
.mw { border-radius: var(--r-lg); background: var(--soft); padding: 18px; display: grid; gap: 10px; align-content: start; }
.mw code { justify-self: start; font: 600 15px/1 var(--mono); background: #fff; color: var(--green); padding: 8px 10px; border-radius: 9px; box-shadow: inset 0 0 0 1.5px var(--green); }
.mw p { font-size: 15px; color: var(--ink-2); }
.mw p b { color: var(--ink); }

/* help */
.qa { display: grid; gap: 8px; }
.qa details { border: 1.5px solid var(--line); border-radius: var(--r-md); }
.qa details[open] { border-color: var(--ink); }
.qa summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: center; min-height: 58px; padding: 12px 16px 12px 18px; font-weight: 600; font-size: 16px; }
.qa summary::-webkit-details-marker { display: none; }
.qa details[open] .chev { transform: rotate(180deg); background: var(--ink); color: #fff; }
.qa .a { padding: 0 18px 18px; color: var(--ink-2); font-size: 15.5px; display: grid; gap: 8px; }
.qa .a ul { padding-left: 20px; display: grid; gap: 6px; }
.stuck { margin-top: 10px; background: var(--ink); color: #fff; border-radius: var(--r-lg); padding: clamp(22px, 4vw, 32px); display: grid; gap: 8px; }
.stuck b { font: 800 clamp(20px, 3vw, 28px)/1 var(--display); font-stretch: 125%; text-transform: uppercase; }
.stuck p { color: rgba(255,255,255,.72); max-width: 52ch; }

/* footer */
.foot { margin-top: clamp(64px, 10vw, 112px); border-top: 1px solid var(--line); }
.foot .wrap { padding-block: 32px 40px; display: grid; gap: 22px; }
